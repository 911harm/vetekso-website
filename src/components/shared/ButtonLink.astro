---
interface Props {
  href: string;
  label: string;
  btnClasses?: string;
}

const { label, btnClasses = "", href } = Astro.props;
---

<a
  href={href}
  class={`
    inline-flex items-center justify-center
    px-6 py-2.5 font-semibold text-center
    transition-all duration-300 ease-in-out
    cursor-pointer select-none
    w-full max-w-[220px] h-[48px]
    shadow-lg
    ${btnClasses}
  `}
>
  {label}
</a>

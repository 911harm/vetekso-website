---
import { Image } from "astro:assets";
import { NAV_LINKS, IMPORTANT_NAV_LINKS } from "../../utils/consts";
import LinkedinIcon from "./LinkedinIcon.astro";
---

<footer
  class="relative z-10 w-full mt-20 border-t border-white/10 bg-space-950/90 md:bg-space-950/60 backdrop-blur-lg"
  transition:animate="none"
>
  <div class="max-w-6xl mx-auto py-16 px-6 sm:px-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12 justify-between">
      <!-- Columna 1: Logo e Info -->
      <div class="flex flex-col gap-6 max-md:pb-4 max-md:border-b max-md:border-white/5">
        <a href="/" class="inline-block hover:opacity-90 transition-opacity">
          <Image
            src="/images/logo-main.svg"
            width="140"
            height="28"
            alt="Vetekso Logo"
          />
        </a>
        <p class="text-sm text-white/50 leading-relaxed max-w-[240px]">
          Convertimos tus ideas en experiencias digitales tangibles y de alto impacto.
        </p>
        <a
          class="inline-flex justify-center items-center w-9 h-9 rounded-lg bg-white/5 hover:bg-white/15 border border-white/10 hover:border-white/20 text-white transition-all duration-300 self-start"
          href="https://www.linkedin.com/company/vetek-so/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <LinkedinIcon />
        </a>
      </div>

      <!-- Columna 2: Contacto (Accordion en mobile) -->
      <details class="footer-accordion group max-md:border-b max-md:border-white/5 max-md:py-2 md:py-0" open>
        <summary class="flex justify-between items-center list-none cursor-pointer md:pointer-events-none [&::-webkit-details-marker]:hidden">
          <h4 class="text-sm font-bold uppercase tracking-wider text-white/90">CONTACTO</h4>
          <span class="text-white/40 group-open:rotate-180 transition-transform duration-300 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 md:mt-6 flex flex-col gap-3 accordion-content">
          <a
            href="tel:+573162951345"
            class="text-sm text-white/60 hover:text-fuchsia-400 transition-colors duration-300 flex items-center gap-2"
          >
            Llámanos: +57 316 295 1345
          </a>
          <a
            href="https://wa.me/573104848412"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-white/60 hover:text-fuchsia-400 transition-colors duration-300 flex items-center gap-2"
          >
            WhatsApp: +57 310 484 8412
          </a>
          <a
            href="mailto:info@vetekso.com"
            class="text-sm text-white/60 hover:text-fuchsia-400 transition-colors duration-300 flex items-center gap-2"
          >
            Correo: info@vetekso.com
          </a>
        </div>
      </details>

      <!-- Columna 3: Enlaces Rápidos (Accordion en mobile) -->
      <details class="footer-accordion group max-md:border-b max-md:border-white/5 max-md:py-2 md:py-0" open>
        <summary class="flex justify-between items-center list-none cursor-pointer md:pointer-events-none [&::-webkit-details-marker]:hidden">
          <h4 class="text-sm font-bold uppercase tracking-wider text-white/90">EXPLORA</h4>
          <span class="text-white/40 group-open:rotate-180 transition-transform duration-300 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 md:mt-6 flex flex-col gap-3 accordion-content">
          {
            NAV_LINKS.map(({ label, pathname }) => (
              <a
                href={pathname}
                class="text-sm text-white/60 hover:text-fuchsia-400 transition-colors duration-300"
              >
                {label}
              </a>
            ))
          }
        </div>
      </details>

      <!-- Columna 4: Legal (Accordion en mobile) -->
      <details class="footer-accordion group max-md:py-2 md:py-0" open>
        <summary class="flex justify-between items-center list-none cursor-pointer md:pointer-events-none [&::-webkit-details-marker]:hidden">
          <h4 class="text-sm font-bold uppercase tracking-wider text-white/90">POLÍTICAS</h4>
          <span class="text-white/40 group-open:rotate-180 transition-transform duration-300 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 md:mt-6 flex flex-col gap-3 accordion-content">
          {
            IMPORTANT_NAV_LINKS.map(({ label, pathname }) => (
              <a
                href={pathname}
                class="text-sm text-white/60 hover:text-fuchsia-400 transition-colors duration-300 leading-normal"
              >
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </div>

    <!-- Barra de derechos reservados -->
    <div class="mt-16 pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4">
      <span class="text-xs text-white/40">
        &copy; {new Date().getFullYear()} VETEK SO. Todos los derechos reservados.
      </span>
      <span class="text-xs text-white/30">
        Diseñado para el futuro digital.
      </span>
    </div>
  </div>
</footer>

<style>
  /* Custom summary styles for webkit */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Sweep animation when details opens on mobile */
  @media (max-width: 767px) {
    details[open] .accordion-content {
      animation: sweep 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes sweep {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function setupFooterAccordions() {
    const accordions = document.querySelectorAll('.footer-accordion');
    const isMobile = window.innerWidth < 768;

    accordions.forEach((acc) => {
      if (!isMobile) {
        acc.setAttribute('open', '');
      } else {
        // Safe check to avoid closing if it was manually toggled, but typically closed initially on mobile
        acc.removeAttribute('open');
      }
    });
  }

  // Run on initial load
  setupFooterAccordions();

  // Run on resize
  window.addEventListener('resize', setupFooterAccordions);

  // Astro page swap support (ViewTransitions compat)
  document.addEventListener('astro:after-swap', setupFooterAccordions);
</script>

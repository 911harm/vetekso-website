---
import ToggleMenu from "../client/ToggleMenu";
import NavLinks from "../client/NavLinks";
import NavMenu from "../client/NavMenu";
import Image from "astro/components/Image.astro";
---

<header
  class="fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-6xl z-50 rounded-2xl border border-white/10 backdrop-blur-xl shadow-xl shadow-black/40 header-capsule"
  transition:animate="none"
>
  <nav
    class="h-[80px] max-w-6xl mx-auto px-6 sm:px-10 flex justify-between items-center"
  >
  <a href="/" class="flex items-center gap-2 hover:opacity-90">
    <Image
      class="max-[500px]:max-h-[24px] max-[500px]:max-w-[110px]"
      src="/images/logo-main.svg"
      width="150"
      height="30"
      loading="eager"
      alt="Vetekso Logo"
    />
  </a>
    <ToggleMenu client:load />
    <NavLinks client:load currentPathname={Astro.url.pathname} />
  </nav>
  <NavMenu client:load currentPathname={Astro.url.pathname} />
</header>

<style>
  .header-capsule {
    background-color: #030014 !important;
  }
  @media (min-width: 768px) {
    .header-capsule {
      background-color: rgba(3, 0, 20, 0.85) !important;
    }
  }
</style>

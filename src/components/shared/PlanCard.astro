---
import ButtonLink from "./ButtonLink.astro";

interface Props {
  plan: string;
}

const { plan } = Astro.props;
const isPro = plan.toLowerCase() === "pro";
---

<article 
  class={`w-full max-w-[360px] rounded-3xl p-8 transition-all duration-500 relative flex flex-col justify-between overflow-hidden shadow-2xl group border ${
    isPro 
      ? "bg-space-950/80 border-fuchsia-500/30 shadow-fuchsia-500/5 hover:border-fuchsia-500/60" 
      : "bg-white/5 border-white/10 hover:border-white/20"
  } hover:-translate-y-2`}
>
  <!-- Efecto de brillo de fondo para Pro -->
  {isPro && (
    <div class="absolute -top-20 -right-20 w-44 h-44 bg-fuchsia-500/10 rounded-full blur-[40px] pointer-events-none group-hover:bg-fuchsia-500/20 transition-all duration-500" />
  )}

  <div>
    <!-- Encabezado de la Tarjeta -->
    <div class="flex justify-between items-center mb-6">
      <h3 class={`text-2xl font-bold font-display ${isPro ? "text-fuchsia-400" : "text-white"}`}>
        {plan}
      </h3>
      {isPro && (
        <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-fuchsia-500/20 text-fuchsia-300 rounded-full border border-fuchsia-500/30">
          Recomendado
        </span>
      )}
    </div>

    <!-- Descripción del Plan -->
    <p class="text-sm text-white/60 mb-6 leading-relaxed">
      {isPro 
        ? "Ideal para empresas en rápido crecimiento que necesitan múltiples entregas concurrentes." 
        : "Perfecto para startups y negocios que desean comenzar a validar y optimizar su presencia digital."}
    </p>

    <!-- Precio -->
    <div class="flex items-baseline gap-1.5 mb-6 pb-6 border-b border-white/10">
      <span class="text-4xl font-extrabold text-white font-display">
        {isPro ? "$1,399" : "$799"}
      </span>
      <span class="text-white/50 text-sm">/ por mes</span>
    </div>

    <!-- Lista de Inclusiones con SVG Checks -->
    <div class="space-y-4 mb-8">
      <span class="text-xs font-bold text-white/40 uppercase tracking-widest block mb-4">Qué incluye:</span>
      
      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">{isPro ? "Dos soluciones a la vez" : "Una solución a la vez"}</span>
      </div>

      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">Entrega promedio de 72 horas</span>
      </div>

      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">Clientes y usuarios ilimitados</span>
      </div>

      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">Desarrollo de flujos web completos</span>
      </div>

      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">Facturación fácil con tarjeta</span>
      </div>

      <div class="flex items-center gap-3">
        <svg class={`w-5 h-5 flex-shrink-0 ${isPro ? "text-fuchsia-400" : "text-cyan-400"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm text-white/80 font-medium">Pausa o cancela en cualquier momento</span>
      </div>
    </div>
  </div>

  <!-- Botón de Acción -->
  <ButtonLink
    href="/contacto"
    label="Contratar plan"
    btnClasses={`w-full max-w-none rounded-xl font-bold transition-all duration-300 text-base ${
      isPro
        ? "bg-gradient-to-r from-fuchsia-500 to-purple-600 hover:from-fuchsia-600 hover:to-purple-750 text-white shadow-lg shadow-fuchsia-500/20"
        : "bg-white/10 hover:bg-white/15 text-white"
    }`}
  />
</article>

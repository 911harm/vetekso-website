---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import ButtonLink from "../../components/shared/ButtonLink.astro";
---

<Layout
  title="Vetekso - About Us"
  description="Learn who we are, our mission, vision, and core values. We are a digital agency committed to speed, trust, and quality."
  locale="en"
>
  <!-- Mission Section -->
  <section class="relative py-16 lg:py-24 overflow-hidden border-b border-white/5 bg-space-950/10">
    <div class="absolute top-1/4 right-0 w-[300px] h-[300px] rounded-full bg-fuchsia-500/5 blur-[100px] pointer-events-none z-0"></div>

    <div class="relative z-10 w-full max-w-6xl px-6 sm:px-12 mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16 xl:gap-24">
      <div class="w-full lg:w-1/2 flex flex-col gap-6 animate-fade-in-up">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">Innovation & Results</span>
          <h2 class="font-extrabold text-white mt-2 mb-6 leading-tight text-4xl sm:text-5xl text-left">
            Build Your Digital Future With Us
          </h2>
          <p class="text-lg text-white/70 leading-relaxed font-light mb-6">
            Our goal is simple yet powerful: we want to help you build an online presence that stands out from the crowd. How? With speed, trust, and quality at every step of the process. From design to optimization, we are here to give you the tools and support you need to achieve your digital goals.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md relative overflow-hidden group hover:border-fuchsia-500/30 transition-all duration-300">
          <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-blue-500 to-fuchsia-500"></div>
          <h3 class="font-extrabold text-white text-xl mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Our Mission
          </h3>
          <p class="text-sm text-white/60 leading-relaxed">
            To provide comprehensive information technology solutions, specializing in user experience design, web development, and support. We are committed to delivering fast, reliable, and high-quality services, ensuring total client satisfaction and empowering their digital presence through constant innovation and adaptation to the latest trends.
          </p>
        </div>
      </div>

      <div class="w-full lg:w-1/2 flex justify-center items-center animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="relative w-full max-w-[450px]">
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-blue-500 to-fuchsia-500 opacity-20 blur-lg"></div>
          <div class="relative rounded-2xl border border-white/10 overflow-hidden bg-space-850">
            <Image class="w-full h-auto object-cover opacity-90" src="/images/mission.png" width={450} height={450} loading="eager" alt="Vetekso Mission" />
          </div>
          <div class="absolute -bottom-6 -left-6 md:-left-10 p-4 rounded-xl bg-space-900/90 border border-white/10 backdrop-blur-md shadow-xl flex items-center gap-3 animate-float-slow">
            <div class="w-10 h-10 rounded-lg bg-fuchsia-500/20 flex items-center justify-center text-fuchsia-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="text-xs text-white/50">Satisfaction</div>
              <div class="font-extrabold text-white text-sm">+98% Happy Clients</div>
            </div>
          </div>
          <div class="absolute -top-6 -right-6 p-4 rounded-xl bg-space-900/90 border border-white/10 backdrop-blur-md shadow-xl flex items-center gap-3 animate-float-medium" style="animation-delay: -3s;">
            <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center text-blue-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="text-xs text-white/50">Efficiency</div>
              <div class="font-extrabold text-white text-sm">On-Time Delivery</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Section -->
  <section class="relative py-16 lg:py-24 overflow-hidden border-b border-white/5 bg-space-900/10">
    <div class="absolute bottom-1/4 left-0 w-[300px] h-[300px] rounded-full bg-blue-500/5 blur-[100px] pointer-events-none z-0"></div>

    <div class="relative z-10 w-full max-w-6xl px-6 sm:px-12 mx-auto flex flex-col lg:flex-row-reverse items-center gap-12 lg:gap-16 xl:gap-24">
      <div class="w-full lg:w-1/2 flex flex-col gap-6 animate-fade-in-up">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">Toward Leadership</span>
          <h2 class="font-extrabold text-white mt-2 mb-6 leading-tight text-4xl sm:text-5xl text-left">Our Vision</h2>
          <p class="text-lg text-white/70 leading-relaxed font-light mb-6">
            To be recognized as industry leaders, standing out for our excellence in user experience design, web development, and support. We aspire to be the first choice for businesses seeking innovative, fast, and reliable services — with a constant focus on quality and continuous improvement. We envision a future where every business can fully harness the potential of digital technology with our help.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-1">Our Core Values</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-5 rounded-xl bg-white/5 border border-white/10 hover:border-fuchsia-500/30 hover:bg-fuchsia-500/5 transition-all duration-300">
              <div class="w-8 h-8 rounded-lg bg-fuchsia-500/20 flex items-center justify-center text-fuchsia-400 mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <h4 class="font-extrabold text-white text-base mb-1">Speed</h4>
              <p class="text-xs text-white/60 leading-relaxed">We prioritize on-time project delivery without compromising quality.</p>
            </div>
            <div class="p-5 rounded-xl bg-white/5 border border-white/10 hover:border-blue-500/30 hover:bg-blue-500/5 transition-all duration-300">
              <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center text-blue-400 mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
              <h4 class="font-extrabold text-white text-base mb-1">Trust</h4>
              <p class="text-xs text-white/60 leading-relaxed">Solid relationships through continuous technical support and stable solutions.</p>
            </div>
            <div class="p-5 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-500/30 hover:bg-cyan-500/5 transition-all duration-300">
              <div class="w-8 h-8 rounded-lg bg-cyan-500/20 flex items-center justify-center text-cyan-400 mb-3">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
              </div>
              <h4 class="font-extrabold text-white text-base mb-1">Quality</h4>
              <p class="text-xs text-white/60 leading-relaxed">Excellence in design, development, and post-launch support.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full lg:w-1/2 flex justify-center items-center animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="relative w-full max-w-[450px]">
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-fuchsia-500 to-blue-500 opacity-20 blur-lg"></div>
          <div class="relative rounded-2xl border border-white/10 overflow-hidden bg-space-850">
            <Image class="w-full h-auto object-cover opacity-90" src="/images/vision.jpg" width={450} height={450} loading="lazy" alt="Vetekso Vision" />
          </div>
          <div class="absolute -bottom-6 -right-6 md:-right-10 p-4 rounded-xl bg-space-900/90 border border-white/10 backdrop-blur-md shadow-xl flex items-center gap-3 animate-float-medium">
            <div class="w-10 h-10 rounded-lg bg-cyan-500/20 flex items-center justify-center text-cyan-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
            </div>
            <div>
              <div class="text-xs text-white/50">Development</div>
              <div class="font-extrabold text-white text-sm">Cutting-Edge Tech</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="relative py-16 lg:py-24 border-b border-white/5 bg-space-950/20">
    <div class="absolute bottom-[-10%] right-[20%] w-[350px] h-[350px] rounded-full bg-fuchsia-500/5 blur-[120px] pointer-events-none z-0"></div>
    <div class="relative z-10 w-full max-w-4xl px-6 sm:px-12 mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">FAQ</span>
        <h2 class="font-extrabold text-white mt-2 mb-4 leading-tight">Answering Your Questions</h2>
        <p class="text-lg text-white/60 leading-relaxed font-light">Here are answers to some of the most common questions about how we work and what we can do for you.</p>
      </div>

      <div class="flex flex-col gap-4 mb-12">
        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">What services do you offer?</h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">We offer a wide range of digital solutions, including web consulting and auditing, interactive design and redesign, custom software development, top-tier SEO optimization, continuous maintenance, and guaranteed technical support. We build fast, responsive, and conversion-optimized platforms.</p>
          </div>
        </details>

        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">What is your project delivery time?</h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">Delivery time varies by service type and project complexity. A premium landing page can be completed in 1–2 weeks, while a custom platform or robust e-commerce can take 4–6 weeks. We strive for fast and efficient solutions without compromising quality.</p>
          </div>
        </details>

        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">How can I contact you and get started?</h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">It's simple! You can schedule a free 30-minute strategic video call through our Contact page calendar, send us a WhatsApp for immediate attention, or email us. We'll evaluate your goals at no cost and present a proposal tailored to your business.</p>
          </div>
        </details>
      </div>

      <div class="flex justify-center">
        <ButtonLink href="/en/contact" label="Book a Session" btnClasses="bg-custom-gradient-2 hover:bg-none hover:bg-shadow text-white border border-transparent hover:border-white/40" />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('details').forEach((el) => {
    const summary = el.querySelector('summary');
    const content = el.querySelector('div');
    if (!summary || !content) return;
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      if (el.hasAttribute('open')) {
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.offsetHeight;
        content.style.transition = 'max-height 0.25s ease-out, opacity 0.25s ease-out';
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        setTimeout(() => { el.removeAttribute('open'); content.style.maxHeight = ''; content.style.opacity = ''; content.style.transition = ''; }, 250);
      } else {
        el.setAttribute('open', '');
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        content.offsetHeight;
        content.style.transition = 'max-height 0.25s ease-out, opacity 0.25s ease-out';
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.style.opacity = '1';
        setTimeout(() => { content.style.maxHeight = ''; content.style.opacity = ''; content.style.transition = ''; }, 250);
      }
    });
  });
</script>

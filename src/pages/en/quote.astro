---
import Layout from "../../layouts/Layout.astro";
import ButtonLink from "../../components/shared/ButtonLink.astro";
---

<Layout
  title="Vetekso - Get a Quote"
  description="Tell us what you need and we'll prepare a personalized proposal. Every project is unique and deserves a tailored solution."
  pageId="quote"
  locale="en"
>
  <section class="relative min-h-[85vh] max-w-5xl px-6 sm:px-12 py-16 lg:py-24 mx-auto z-10 w-full flex flex-col justify-center items-center">

    <div class="text-center max-w-2xl mx-auto mb-16 animate-fade-in-up">
      <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">No fixed rates</span>
      <h1 class="font-extrabold text-white mt-2 mb-4 leading-tight text-5xl sm:text-6xl bg-gradient-to-r from-white via-white to-white/70 bg-clip-text text-transparent">
        Quote Your Project
      </h1>
      <p class="text-lg text-white/60 leading-relaxed font-light">
        Every business is different. We don't believe in rigid plans: we design solutions tailored to the exact needs and budget of your business.
      </p>
    </div>

    <div class="w-full max-w-3xl grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16 animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-fuchsia-500/30 transition-all duration-300 text-center">
        <div class="text-3xl mb-3">🎯</div>
        <h3 class="text-white font-bold text-base mb-1">Custom proposal</h3>
        <p class="text-white/50 text-sm leading-relaxed">Real analysis of your requirements — no generic templates.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-500/30 transition-all duration-300 text-center">
        <div class="text-3xl mb-3">⚡</div>
        <h3 class="text-white font-bold text-base mb-1">Fast response</h3>
        <p class="text-white/50 text-sm leading-relaxed">We'll reach out within 24 hours with a concrete proposal.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-500/30 transition-all duration-300 text-center">
        <div class="text-3xl mb-3">🤝</div>
        <h3 class="text-white font-bold text-base mb-1">No commitment</h3>
        <p class="text-white/50 text-sm leading-relaxed">The quote is free and pressure-free. You decide.</p>
      </div>
    </div>

    <div class="w-full max-w-3xl bg-white/5 border border-white/10 backdrop-blur-md rounded-3xl p-8 md:p-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-8 md:gap-12 hover:border-fuchsia-500/30 transition-all duration-300 animate-fade-in-up" style="animation-delay: 0.2s;">
      <div class="absolute -bottom-20 -right-20 w-48 h-48 bg-fuchsia-500/10 rounded-full blur-[40px] pointer-events-none"></div>
      <div class="flex-grow text-left relative z-10">
        <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">Ready to start?</span>
        <h3 class="font-extrabold text-white text-2xl md:text-3xl mt-1 mb-4">Let's talk about your project</h3>
        <p class="text-sm md:text-base text-white/70 leading-relaxed font-light">Fill out the contact form with a brief description of what you need. Our team will analyze your case and send you a detailed proposal at no cost.</p>
      </div>
      <div class="shrink-0 w-full md:w-auto relative z-10">
        <ButtonLink href="/en/contact" label="Request a quote" btnClasses="w-full md:w-auto bg-gradient-to-r from-blue-500 to-fuchsia-500 hover:from-blue-600 hover:to-fuchsia-600 text-white rounded-xl shadow-lg hover:-translate-y-0.5 duration-300 transition-all font-semibold px-8 py-3.5 text-center whitespace-nowrap block" />
      </div>
    </div>

  </section>
</Layout>

---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ButtonLink from "../../components/shared/ButtonLink.astro";

const SERVICES = [
  { image: "/images/web-assessment.jpg", label: "Web Consulting & Research", badge: "Strategy", description: "We provide guidance to improve your business's online presence. We meticulously analyze your market and competition to design personalized, effective, and result-oriented digital strategies.", color: "blue" },
  { image: "/images/redesign.jpg", label: "Web Design & Redesign", badge: "Interactivity", description: "We create intuitive and memorable digital experiences. We focus on designing aesthetic interfaces that capture your brand's essence and convert visitors into loyal clients.", color: "fuchsia" },
  { image: "/images/imagen desarrollo.jpg", label: "Custom Development", badge: "Solutions", description: "We adapt and develop scalable custom features. Whether improving an existing site or building from scratch, we code with robust, limitless architecture.", color: "cyan" },
  { image: "/images/imagen Seo.jpg", label: "SEO Positioning", badge: "Visibility", description: "We optimize your platform for search engines with best technical practices. We increase your organic visibility, improve load performance, and structure your content to rank on Google.", color: "blue" },
  { image: "/images/back.jpg", label: "Back Office", badge: "Systems", description: "We manage and integrate your business's internal operations. From workflow automation to database management, we help you keep your platform always up to date.", color: "fuchsia" },
  { image: "/images/support.jpg", label: "Technical Support", badge: "Guarantee", description: "We guarantee total stability and peace of mind. Constant monitoring, preventive maintenance, and rapid resolution of any technical incident to keep your site always operational.", color: "cyan" },
];
---

<Layout
  title="Vetekso - Our Services"
  description="Discover our range of services designed to cover all your needs. We offer personalized solutions that drive your business success."
  pageId="services"
  locale="en"
>
  <section class="relative py-16 lg:py-24 max-w-6xl px-6 sm:px-12 mx-auto z-10 w-full flex flex-col justify-center items-center">
    <div class="text-center max-w-2xl mx-auto mb-16 animate-fade-in-up">
      <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">What We Do</span>
      <h1 class="font-extrabold text-white mt-2 mb-4 leading-tight text-5xl sm:text-6xl bg-gradient-to-r from-white via-white to-white/70 bg-clip-text text-transparent">
        Our Services
      </h1>
      <p class="text-lg text-white/60 leading-relaxed font-light">
        We offer cutting-edge digital solutions combining premium design with scalable technology and unconditional continuous support.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full mb-16 animate-fade-in-up" style="animation-delay: 0.15s;">
      {SERVICES.map((item, index) => (
        <article class="group relative rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-xl hover:shadow-2xl">
          <div class={`absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r ${item.color === 'fuchsia' ? 'from-fuchsia-500 to-purple-600' : item.color === 'cyan' ? 'from-cyan-400 to-blue-500' : 'from-blue-500 to-fuchsia-500'}`} />
          <div class="p-6 flex-grow flex flex-col">
            <div class="relative w-full aspect-[16/10] rounded-xl overflow-hidden mb-6 border border-white/5 bg-space-850">
              <span class="absolute top-3 left-3 z-10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-space-950/80 text-white/80 rounded-full border border-white/10 backdrop-blur-md">{item.badge}</span>
              <Image class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" src={item.image} width={350} height={220} loading={index > 2 ? "lazy" : "eager"} alt={item.label} />
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-fuchsia-400 transition-colors duration-300">{item.label}</h3>
            <p class="text-sm text-white/65 leading-relaxed font-light flex-grow">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="flex flex-col items-center gap-4 animate-fade-in-up" style="animation-delay: 0.3s;">
      <h3 class="text-lg font-bold text-white/80">Ready to boost your digital presence?</h3>
      <ButtonLink href="/en/contact" label="Book a call" btnClasses="bg-gradient-to-r from-blue-500 via-fuchsia-500 to-cyan-500 hover:from-blue-600 hover:via-fuchsia-600 hover:to-cyan-600 text-white rounded-xl shadow-lg hover:-translate-y-0.5 duration-300 transition-all font-semibold px-8 py-3" />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="relative py-16 lg:py-24 border-t border-white/5 bg-space-950/20">
    <div class="absolute top-[-10%] right-[20%] w-[350px] h-[350px] rounded-full bg-blue-500/5 blur-[120px] pointer-events-none z-0"></div>

    <div class="relative z-10 w-full max-w-4xl px-6 sm:px-12 mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-extrabold uppercase tracking-widest text-cyan-400">FAQ</span>
        <h2 class="font-extrabold text-white mt-2 mb-4 leading-tight">
          Most Common Questions
        </h2>
        <p class="text-lg text-white/60 leading-relaxed font-light">
          Answers to the most common questions about our services to help you make the best decision.
        </p>
      </div>

      <div class="flex flex-col gap-4 mb-12">

        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">
              Do you work with any type of business or industry?
            </h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5 transition-all duration-300">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">
              Yes, we work with companies of all sizes and sectors — from early-stage startups to established businesses. We tailor every solution to the specific context, scale, and objectives of your company, regardless of your industry.
            </p>
          </div>
        </details>

        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">
              What if my site already exists and I just want to improve it?
            </h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5 transition-all duration-300">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">
              That's one of the most common scenarios we handle. We perform a full audit of your current site and propose targeted improvements or a partial redesign — no need to start from scratch. We maximize what's already working.
            </p>
          </div>
        </details>

        <details class="group rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center p-6 cursor-pointer select-none">
            <h3 class="font-bold text-white text-lg pr-4 font-sans leading-snug">
              What does technical support include after launch?
            </h3>
            <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 group-open:rotate-180 group-open:text-fuchsia-400 group-open:bg-fuchsia-500/10 group-open:border-fuchsia-500/20 transition-all duration-300 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="overflow-hidden px-6 pb-6 pt-0 border-t border-white/5 transition-all duration-300">
            <p class="text-base text-white/70 leading-relaxed font-light mt-4">
              We offer continuous monitoring, preventive updates, bug fixes, and assistance with any technical issue. The exact scope of support is defined and agreed upon in each proposal, adapting to your business needs.
            </p>
          </div>
        </details>

      </div>

      <div class="flex justify-center">
        <ButtonLink
          href="/en/contact"
          label="Book a Session"
          btnClasses="bg-custom-gradient-2 hover:bg-none hover:bg-shadow text-white border border-transparent hover:border-white/40"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('details').forEach((el) => {
    const summary = el.querySelector('summary');
    const content = el.querySelector('div');
    if (!summary || !content) return;
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      if (el.hasAttribute('open')) {
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.offsetHeight;
        content.style.transition = 'max-height 0.25s ease-out, opacity 0.25s ease-out';
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        setTimeout(() => { el.removeAttribute('open'); content.style.maxHeight = ''; content.style.opacity = ''; content.style.transition = ''; }, 250);
      } else {
        el.setAttribute('open', '');
        content.style.maxHeight = '0px';
        content.style.opacity = '0';
        content.offsetHeight;
        content.style.transition = 'max-height 0.25s ease-out, opacity 0.25s ease-out';
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.style.opacity = '1';
        setTimeout(() => { content.style.maxHeight = ''; content.style.opacity = ''; content.style.transition = ''; }, 250);
      }
    });
  });
</script>

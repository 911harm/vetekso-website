---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/pages/inicio/HeroSection.astro";
import InvitationSection from "../components/pages/inicio/InvitationSection.astro";
import PlansSection from "../components/pages/inicio/PlansSection.astro";
import ServicesSection from "../components/pages/inicio/ServicesSection.astro";
---

<Layout
  title="Inicio - VETEK SO"
  description="En Vetek So te brindamos las herramientas y la orientación necesarias para prosperar en el entorno digital"
>
  <HeroSection />
  <InvitationSection />
  <PlansSection />
  <ServicesSection />
</Layout>

<!-- Client-side language detection: runs before paint when possible -->
<script is:inline>
  (function () {
    try {
      var saved = document.cookie.match(/(?:^|;\s*)lang=([^;]+)/);
      if (saved) {
        if (saved[1] === 'en') window.location.replace('/en');
        return; // cookie set — respect it, no further action
      }
      // First visit: check browser preference
      var lang = (navigator.language || navigator.userLanguage || '').toLowerCase();
      if (lang.startsWith('en')) {
        document.cookie = 'lang=en;path=/;max-age=' + (60 * 60 * 24 * 365) + ';SameSite=Lax';
        window.location.replace('/en');
      }
    } catch (_) {}
  })();
</script>
